# MongoDB connection (docker compose exposes a single-node replica set on 27017)
MONGODB_URI=mongodb://localhost:27017/su_obe?replicaSet=rs0&directConnection=true

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL of the app
APP_URL=http://localhost:3000
